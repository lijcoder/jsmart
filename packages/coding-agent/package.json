{
	"name": "@jsmart/jsmart-coding-agent",
	"version": "0.0.1",
	"description": "Interactive coding agent CLI with session management",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"jsmart-coding": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"start": "node dist/cli.js",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"ai",
		"agent",
		"coding",
		"cli"
	],
	"author": "Jie",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/openclaw-dev/jsmart-mono.git",
		"directory": "packages/coding-agent"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"dependencies": {
		"@jsmart/jsmart-agent-core": "^0.0.1",
		"@jsmart/jsmart-ai": "^0.0.1",
		"@jsmart/jsmart-harness": "^0.0.1",
		"@sinclair/typebox": "^0.34.30",
		"ajv": "^8.17.1"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	}
}
