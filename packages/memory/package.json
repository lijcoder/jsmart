{
	"name": "@jsmart/jsmart-memory",
	"version": "0.0.1",
	"description": "Persistent memory system for jsmart agents",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"ai",
		"agent",
		"memory",
		"llm"
	],
	"author": "Jie",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/openclaw-dev/jsmart-mono.git",
		"directory": "packages/memory"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"dependencies": {
		"@jsmart/jsmart-ai": "^0.0.1",
		"@node-rs/jieba": "^2.0.1"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	}
}
