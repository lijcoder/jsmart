{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": ["./*"],
			"@jsmart/jsmart-ai": ["./packages/ai/src/index.ts"],
			"@jsmart/jsmart-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@jsmart/jsmart-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@jsmart/jsmart-ai/dist/*": ["./packages/ai/src/*"],
			"@jsmart/jsmart-agent-core": ["./packages/agent/src/index.ts"],
			"@jsmart/jsmart-agent-core/*": ["./packages/agent/src/*"],
			"@jsmart/jsmart-harness": ["./packages/harness/src/index.ts"],
			"@jsmart/jsmart-harness/*": ["./packages/harness/src/*"],
			"@jsmart/jsmart-gateway": ["./packages/gateway/src/index.ts"],
			"@jsmart/jsmart-gateway/*": ["./packages/gateway/src/*"],
			"@sinclair/typebox": ["./node_modules/@sinclair/typebox"],
			"@jsmart/jsmart-agent-old": ["./packages/agent-old/src/index.ts"],
			"@jsmart/jsmart-agent-old/*": ["./packages/agent-old/src/*"],
			"@jsmart/jsmart-memory": ["./packages/memory/src/index.ts"],
			"@jsmart/jsmart-memory/*": ["./packages/memory/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*"],
	"exclude": ["packages/harness-web/src/web/**/*", "packages/desktop/**/*", "**/dist/**"]
}
